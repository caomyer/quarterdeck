{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "firstmate desktop",
  "version": "0.1.0",
  "identifier": "dev.firstmate.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4177",
    "beforeDevCommand": "pnpm dev --port 4177 --strictPort",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "firstmate",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../engine": "engine",
      "../engine/.agents/skills": "engine/.claude/skills",
      "../engine/.claude/mods/firstmate-calm": "engine/.agents/skills/firstmate-calm"
    },
    "targets": "all",
    "macOS": {
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MEU2NzNCMUU2Mjk5QTYKUldTbW1XSWVPMmNPWkZsQ0VTbG5hT1dCODdHcTF3Q0JKT3VTWHZtQW5vMXFnODM5VzJudmQ0NkoK",
      "endpoints": [
        "https://github.com/caomyer/quarterdeck/releases/latest/download/latest.json"
      ]
    }
  }
}
